"""Runs both decoders over recorded slots and writes the comparison. See docs/dev/shadow.md.

  ms110d-shadow-decode pending          every slot directory with an audio.wav and no compare.md yet; a slot that has failed
                                        three times is given up on (failed.json holds the reason; the daily report lists it)
  ms110d-shadow-decode slot DIR         one slot, redone even if it was done before
  ms110d-shadow-decode all              every slot, redone
  ms110d-shadow-decode daily [DATE]     write reports/DATE.md (default: yesterday, UTC) from the slots' jsonl files

Per slot it writes, next to audio.wav: cxx.jsonl (the C++ decoder), cs.jsonl (the C# decoder) and compare.md.
Both decoders are fed the very same 9600 Hz samples: the C++ tool resamples the recording once
(`ms110d-decode --write-resampled`, matching scripts/corpus/curate.py sample for sample) and the C# twin reads
that file. compare.md is written last, so its presence means the slot is done.

Environment: SHADOW_SLOTS (default /var/lib/ms110d-shadow/slots), SHADOW_REPORTS (default /var/lib/ms110d-shadow/reports),
SHADOW_HOME (default /opt/ms110d-shadow, holding bin/ms110d-decode, cs/CsharpVectors and compare.py).
"""
import datetime as dt, fcntl, json, os, subprocess, sys, time

HOME = os.environ.get("SHADOW_HOME", "/opt/ms110d-shadow")
SLOTS = os.environ.get("SHADOW_SLOTS", "/var/lib/ms110d-shadow/slots")
REPORTS = os.environ.get("SHADOW_REPORTS", "/var/lib/ms110d-shadow/reports")
CXX = os.path.join(HOME, "bin", "ms110d-decode")
CS = os.path.join(HOME, "cs", "CsharpVectors")
COMPARE = os.path.join(HOME, "compare.py")


MAX_ATTEMPTS = 3   # a slot that fails this many times is given up on (failed.json says why); `slot` and `all` retry it


def run(cmd, out_path):
    with open(out_path, "wb") as out:
        r = subprocess.run(cmd, stdout=out, stderr=subprocess.PIPE)
    if r.returncode != 0:
        raise RuntimeError(f"{os.path.basename(cmd[0])} exited {r.returncode}: {r.stderr.decode(errors='replace').strip()[-300:]}")


def record_failure(d, error):
    path = os.path.join(d, "failed.json")
    attempts = 0
    if os.path.exists(path):
        attempts = json.load(open(path)).get("attempts", 0)
    with open(path, "w") as f:
        json.dump({"attempts": attempts + 1, "max_attempts": MAX_ATTEMPTS, "error": error,
                   "last": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")}, f)
    return attempts + 1


def given_up(d):
    path = os.path.join(d, "failed.json")
    return os.path.exists(path) and json.load(open(path)).get("attempts", 0) >= MAX_ATTEMPTS


def do_slot(d):
    t0 = time.time()
    wav = os.path.join(d, "audio.wav")
    tmp = os.path.join(d, ".audio-9600.wav")
    try:
        run([CXX, "--write-resampled", tmp, wav], os.path.join(d, ".cxx.raw.jsonl"))
        run([CS, "shadow", "finish", os.path.join(d, ".cxx.raw.jsonl")], os.path.join(d, ".cxx.jsonl"))
        run([CS, "shadow", "decode", tmp], os.path.join(d, ".cs.jsonl"))
        run([sys.executable, "-I", COMPARE, "--cxx", os.path.join(d, ".cxx.jsonl"), "--cs", os.path.join(d, ".cs.jsonl")],
            os.path.join(d, ".compare.md"))
    finally:
        for f in (tmp, os.path.join(d, ".cxx.raw.jsonl")):
            if os.path.exists(f):
                os.remove(f)
    for name in ("cxx.jsonl", "cs.jsonl", "compare.md"):   # compare.md last: it marks the slot done
        os.replace(os.path.join(d, "." + name), os.path.join(d, name))
    if os.path.exists(os.path.join(d, "failed.json")):
        os.remove(os.path.join(d, "failed.json"))
    bursts = sum(1 for line in open(os.path.join(d, "cs.jsonl")) if '"ev":"burst_completed"' in line)
    print(f"{os.path.basename(d)}: done in {time.time() - t0:.0f} s, {bursts} bursts", flush=True)


def slot_dirs():
    return sorted(os.path.join(SLOTS, n) for n in os.listdir(SLOTS)
                  if os.path.exists(os.path.join(SLOTS, n, "audio.wav")) and os.path.exists(os.path.join(SLOTS, n, "meta.json")))


def daily(date):
    if date is None:
        date = (dt.datetime.now(dt.timezone.utc) - dt.timedelta(days=1)).strftime("%Y-%m-%d")
    os.makedirs(REPORTS, exist_ok=True)
    out = os.path.join(REPORTS, date + ".md")
    subprocess.run([sys.executable, "-I", COMPARE, "--daily", SLOTS, date, "-o", out + ".tmp"], check=True)
    os.replace(out + ".tmp", out)
    print("wrote", out)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd not in ("pending", "slot", "all", "daily"):
        sys.exit(__doc__)
    os.makedirs(SLOTS, exist_ok=True)
    lock = open(os.path.join(HOME, ".lock"), "w")
    fcntl.flock(lock, fcntl.LOCK_EX)   # one run at a time, whatever started it
    if cmd == "daily":
        daily(sys.argv[2] if len(sys.argv) > 2 else None)
        return
    dirs = ([sys.argv[2]] if cmd == "slot" else
            slot_dirs() if cmd == "all" else
            [d for d in slot_dirs() if not os.path.exists(os.path.join(d, "compare.md")) and not given_up(d)])
    if cmd in ("slot", "all"):   # an explicit run retries slots that were given up on
        for d in dirs:
            if os.path.exists(os.path.join(d, "failed.json")):
                os.remove(os.path.join(d, "failed.json"))
    done = failed = 0
    for d in dirs:
        try:
            do_slot(d)
            done += 1
        except Exception as e:   # keep going: one bad slot must not block the rest
            failed += 1
            n = record_failure(d, str(e))
            print(f"{os.path.basename(d)}: FAILED (attempt {n} of {MAX_ATTEMPTS}"
                  f"{', giving up' if n >= MAX_ATTEMPTS else ''}): {e}", file=sys.stderr, flush=True)
    print(f"{cmd}: {done} slots done, {failed} failed", flush=True)
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main()
