# Fails unless the shared C library exports exactly the ms110d_ functions.
#   NM   the nm tool    LIB   the shared library
execute_process(COMMAND "${NM}" -D --defined-only "${LIB}" OUTPUT_VARIABLE _out RESULT_VARIABLE _rc)
if(NOT _rc EQUAL 0)
  message(FATAL_ERROR "nm failed on ${LIB}")
endif()
string(REPLACE "\n" ";" _lines "${_out}")
set(_exported "")
foreach(_line IN LISTS _lines)
  # Lines look like "0000000000001129 T ms110d_abi_version"; data symbols are D, B, R.
  if(_line MATCHES "^[0-9a-fA-F]+ [TDBRVW] ([^ ]+)$")
    list(APPEND _exported "${CMAKE_MATCH_1}")
  endif()
endforeach()
set(_bad "")
foreach(_sym IN LISTS _exported)
  if(NOT _sym MATCHES "^ms110d_")
    list(APPEND _bad "${_sym}")
  endif()
endforeach()
if(NOT "ms110d_abi_version" IN_LIST _exported)
  message(FATAL_ERROR "ms110d_abi_version is not exported from ${LIB}")
endif()
if(_bad)
  message(FATAL_ERROR "Unexpected exported symbols in ${LIB}: ${_bad}")
endif()
