cmake_minimum_required(VERSION 3.22)
# Fails unless the shared C library exports exactly the ms110d_ functions.
#   NM   the nm tool    LIB   the shared library    HEADER   ms110d.h
# The exported functions must be exactly the MS110D_API functions the header declares.
execute_process(COMMAND "${NM}" -D --defined-only "${LIB}" OUTPUT_VARIABLE _out RESULT_VARIABLE _rc)
if(NOT _rc EQUAL 0)
  message(FATAL_ERROR "nm failed on ${LIB}")
endif()
string(REPLACE "\n" ";" _lines "${_out}")
set(_exported "")
foreach(_line IN LISTS _lines)
  # Lines look like "0000000000001129 T ms110d_abi_version"; data symbols are D, B, R.
  if(_line MATCHES "^[0-9a-fA-F]+ [TDBRVW] ([^ ]+)$")
    list(APPEND _exported "${CMAKE_MATCH_1}")
  endif()
endforeach()
file(STRINGS "${HEADER}" _hlines REGEX "^MS110D_API ")
set(_declared "")
foreach(_line IN LISTS _hlines)
  if(_line MATCHES "^MS110D_API [^(]*[ *](ms110d_[a-z0-9_]+)\\(")
    list(APPEND _declared "${CMAKE_MATCH_1}")
  endif()
endforeach()
list(LENGTH _declared _ndeclared)
if(_ndeclared LESS 10)
  message(FATAL_ERROR "found only ${_ndeclared} MS110D_API functions in ${HEADER}; the parse is broken")
endif()
list(SORT _declared)
list(SORT _exported)
list(REMOVE_DUPLICATES _exported)
if(NOT _declared STREQUAL _exported)
  set(_missing ${_declared})
  list(REMOVE_ITEM _missing ${_exported})
  set(_extra ${_exported})
  list(REMOVE_ITEM _extra ${_declared})
  message(FATAL_ERROR "Exports differ from the header. Declared but not exported: [${_missing}]. Exported but not declared: [${_extra}]")
endif()
