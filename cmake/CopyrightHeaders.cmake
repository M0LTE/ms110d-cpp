# Fails if any C, C++ or C# source in the repo lacks the copyright and licence header.
# Run as: cmake -DSOURCE_DIR=<repo> -P CopyrightHeaders.cmake
set(_line1 "// Copyright (C) 2026 Thomas Fanning")
set(_line2 "// SPDX-License-Identifier: AGPL-3.0-or-later")
file(GLOB_RECURSE _files RELATIVE "${SOURCE_DIR}"
    "${SOURCE_DIR}/include/*" "${SOURCE_DIR}/src/*" "${SOURCE_DIR}/tests/*" "${SOURCE_DIR}/tools/*")
set(_missing "")
foreach(_f IN LISTS _files)
  if(NOT _f MATCHES "\\.(hpp|cpp|h|c|cs)$|version\\.hpp\\.in$")
    continue()
  endif()
  if(_f MATCHES "/(bin|obj)/")
    continue()
  endif()
  file(STRINGS "${SOURCE_DIR}/${_f}" _head LIMIT_COUNT 2)
  list(LENGTH _head _n)
  if(_n LESS 2)
    list(APPEND _missing "${_f}")
    continue()
  endif()
  list(GET _head 0 _a)
  list(GET _head 1 _b)
  if(NOT _a STREQUAL _line1 OR NOT _b STREQUAL _line2)
    list(APPEND _missing "${_f}")
  endif()
endforeach()
if(_missing)
  list(JOIN _missing "\n  " _list)
  message(FATAL_ERROR "Missing copyright header (first two lines must be:\n${_line1}\n${_line2}\n) in:\n  ${_list}")
endif()
