<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The corpus decode helper is shared with the csharp-vectors tool, so the two cannot disagree. -->
    <Compile Include="../../tools/csharp-vectors/CorpusDecode.cs" Link="CorpusDecode.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exact version, taken from reference/pin.txt. -->
    <PackageReference Include="M0LTE.Ms110d" Version="[$(Ms110dReferenceVersion)]" />
    <!-- Test-only: AWGN for the C++ transmit, C# receive tests. -->
    <!-- Test-only: the IL2P deframer the corpus helper uses (the mailcast framing). -->
    <PackageReference Include="M0LTE.Il2p" Version="[0.3.0]" />
    <PackageReference Include="M0LTE.HfChannel" Version="0.1.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

</Project>
