<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exact version, taken from reference/pin.txt. -->
    <PackageReference Include="M0LTE.Ms110d" Version="[$(Ms110dReferenceVersion)]" />
    <!-- Test-only: AWGN for the C++ transmit, C# receive tests. -->
    <PackageReference Include="M0LTE.HfChannel" Version="0.1.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

</Project>
